# MemeticWorld configuration. Copy to .env (repo root) and fill in.
# With no API key set, the backend runs fully offline: mock LLM + hash embeddings.

# --- Agent LLM: any OpenAI-compatible /chat/completions endpoint -------------------------
# LLM_PROVIDER=openai          # "openai" (any compatible API) or "mock". Default: openai if a key is set.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Ollama:       http://localhost:11434/v1       (LLM_API_KEY can be any string)
#   vLLM/LM Studio: http://localhost:8000/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.9            # "none" to omit (some reasoning models reject it)
# LLM_MAX_TOKENS=300
LLM_JSON_MODE=true             # sends response_format=json_object; set false if your provider rejects it
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT=60
LLM_CACHE=true                 # cache replies in SQLite (keyed by prompt + run seed) so reruns are free

# --- Embeddings (memory retrieval) ---------------------------------------------------------
# EMBED_PROVIDER=openai        # "openai" or "hash" (offline). Default: openai when LLM_PROVIDER=openai.
# EMBED_BASE_URL=              # defaults to LLM_BASE_URL
# EMBED_API_KEY=               # defaults to LLM_API_KEY
EMBED_MODEL=text-embedding-3-small
# If your provider has no /embeddings endpoint, set EMBED_PROVIDER=hash.

# --- Storage / server ------------------------------------------------------------------------
# MEMETIC_DB_PATH=backend/data/memeticworld.db
CORS_ORIGINS=http://localhost:3000

# --- Frontend (read by Next.js; put in frontend/.env.local) ----------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
